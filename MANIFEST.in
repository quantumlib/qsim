# This file controls what's packaged into a Python sdist. It must include the
# minimum needed to build qsimcirq on users's computers using CMake. Note we
# use setuptools-scm, which adds every committed file automatically, so the
# sdist is really "everything committed minus the prune/exclude lines."

# Prune repository, environment, and other things not meant for distribution.
global-exclude .*
prune **/.*
prune apps
prune check
prune circuits
prune dev_tools
prune docs
prune install
prune jupyter
prune tests
prune third_party

# Exclude other unnecessary things.
exclude CITATION.cff
exclude CODE_OF_CONDUCT.md
exclude CONTRIBUTING.md
exclude MANIFEST.in
exclude SUPPORT.md
exclude WORKSPACE

global-exclude BUILD
global-exclude docker-compose.yml
global-exclude Dockerfile
global-exclude Makefile
